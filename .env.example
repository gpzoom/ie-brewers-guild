# Copy this file to `.env` and fill in your keys. `.env` is gitignored.

# Server-side key used by scripts/geocode-members.ts (one-time geocoding).
# In Google Cloud Console: enable "Places API (New)" for this key.
# For safety, give this key an "IP addresses" restriction set to your machine,
# or leave it unrestricted and rotate it after running the script.
GOOGLE_PLACES_API_KEY=

# Public, browser-exposed key used by the live members map (@vis.gl/react-google-maps).
# In Google Cloud Console:
#   - API restriction: "Maps JavaScript API" only
#   - Application restriction: "HTTP referrers" set to your prod + preview domains
# Vite inlines VITE_* at build time — also set this as a build-time environment
# variable in the Cloudflare dashboard (Workers Builds → Build variables).
VITE_GOOGLE_MAPS_API_KEY=

# Public, browser-exposed key used by the Questionnaire form's Web3Forms submission.
# Client-exposed by design (that's how Web3Forms access keys work).
# Also set this as a build-time environment variable in the Cloudflare dashboard.
VITE_WEB3FORMS_KEY=

# Set to "true" to replace the entire site with an Under Construction page
# (see src/components/site/UnderConstruction.tsx). Vite inlines VITE_* at build
# time, so set this as a Cloudflare dashboard build variable (Workers Builds ->
# Build variables) and trigger a new deploy for changes to take effect.
VITE_UNDER_CONSTRUCTION=
