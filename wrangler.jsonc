{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ie-brewers-guild",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Which site this Worker is: the 15-minute job has no request to read it from
  // (Guild member visit emails: staging sends only the Sample test taprooms).
  "keep_vars": true,
  "vars": { "SITE_ORIGIN": "https://iscbrewersguild.org" },
  "ratelimits": [
    {
      "name": "CREATOR_UPLOAD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "0 13 * * *"]
  }
}
