{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ie-brewers-guild",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "ratelimits": [
    {
      "name": "CREATOR_UPLOAD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "0 13 * * *"]
  }
}
