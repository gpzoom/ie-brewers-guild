-- Shared fixtures for the *.test.sql files, pulled in with `\ir` right after
-- each file's `begin;` (psql / pg_prove resolve \ir natively;
-- scripts/test-db.mjs inlines it). Everything here is created inside the
-- test's transaction, which always ends in `rollback`, so none of it is ever
-- committed to the shared staging/production database. Named with .psql,
-- not .sql, so test runners don't try to run it as a test on its own.
--
-- People (auth.users):
--   f0..01 owner   -- owner of m1, m3, m4, m5
--   f0..02 editor  -- full editor of m1, m3, m4, m5
--   f0..03 media   -- media_events of m1, m3, m4, m5
--   f0..04 admin   -- Guild admin, not linked to anyone
--   f0..05 other   -- owner of m2 only
--   f0..06 nobody  -- signed in, linked to nothing
-- Members:
--   m1 f1..01 producer, published, with live hours/slide/link/cover
--   m2 f1..02 producer, published, another member entirely
--   m3 f1..03 producer, draft (never published)
--   m4 f1..04 mobile, published
--   m5 f1..05 producer, applied (not approved yet)
-- Assets:
--   a1, a2 f2..01/02 m1 approved; a3 f2..03 m1 pending;
--   b1 f2..04 m2 approved; c1 f2..05 m3 approved; d1 f2..06 m4 approved

set local search_path = public, extensions;

-- TAP lines are collected here and printed by one select at the end, so the
-- whole run comes back as a single result set (what `supabase db query`
-- returns) and still reads as plain TAP under pg_prove.
create temp table _tap (n serial primary key, line text) on commit drop;
grant all on _tap to public;
grant all on sequence _tap_n_seq to public;

insert into auth.users (id, email, aud, role) values
  ('f0000000-0000-4000-8000-000000000001', 'pgtap-owner@example.test', 'authenticated', 'authenticated'),
  ('f0000000-0000-4000-8000-000000000002', 'pgtap-editor@example.test', 'authenticated', 'authenticated'),
  ('f0000000-0000-4000-8000-000000000003', 'pgtap-media@example.test', 'authenticated', 'authenticated'),
  ('f0000000-0000-4000-8000-000000000004', 'pgtap-admin@example.test', 'authenticated', 'authenticated'),
  ('f0000000-0000-4000-8000-000000000005', 'pgtap-other@example.test', 'authenticated', 'authenticated'),
  ('f0000000-0000-4000-8000-000000000006', 'pgtap-nobody@example.test', 'authenticated', 'authenticated');

insert into public.profiles (id, is_guild_admin)
values ('f0000000-0000-4000-8000-000000000004', true)
on conflict (id) do update set is_guild_admin = true;

