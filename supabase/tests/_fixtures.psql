  ('f1000000-0000-4000-8000-000000000002', 'pgtap-m2', 'producer', 'Other Brewing', 'Ontario', 'published', null),
  ('f1000000-0000-4000-8000-000000000003', 'pgtap-m3', 'producer', 'Never Live Brewing', 'Corona', 'draft', null),
  ('f1000000-0000-4000-8000-000000000004', 'pgtap-m4', 'mobile', 'Rolling Taps', 'Fontana', 'published', null),
  ('f1000000-0000-4000-8000-000000000005', 'pgtap-m5', 'producer', 'Applied Brewing', 'Chino', 'applied', null);

insert into public.member_users (member_id, user_id, role)
select m.id, u.user_id, u.role
from (values
  ('f1000000-0000-4000-8000-000000000001'::uuid),
  ('f1000000-0000-4000-8000-000000000003'::uuid),
  ('f1000000-0000-4000-8000-000000000004'::uuid),
  ('f1000000-0000-4000-8000-000000000005'::uuid)
) as m (id)
cross join (values
  ('f0000000-0000-4000-8000-000000000001'::uuid, 'owner'),
  ('f0000000-0000-4000-8000-000000000002'::uuid, 'editor'),
  ('f0000000-0000-4000-8000-000000000003'::uuid, 'media_events')
) as u (user_id, role);

